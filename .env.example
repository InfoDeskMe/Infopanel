# Copy this file to .env and fill in real values before running
# docker compose. install_linux.sh / win_helper.bat do this automatically
# with randomly generated passwords -- you only need this file if you're
# setting things up by hand.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=symfony_docker
MYSQL_USER=symfony
MYSQL_PASSWORD=

# Symfony's secret, used to sign CSRF tokens and session cookies. docker-compose.yml
# injects this straight into the php container -- backend/.env is not used for it.
APP_SECRET=
